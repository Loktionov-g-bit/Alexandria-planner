# Password for the internal database (generate: openssl rand -base64 24)
POSTGRES_PASSWORD=change-me
# Public address users open in the browser (behind your reverse proxy)
PLANNER_BASE_URL=https://planner.example.com
# Host port the app listens on
PLANNER_PORT=8000

# Image tag of the stable and (optional) beta containers
PLANNER_TAG=stable
PLANNER_BETA_TAG=beta
